{
  "expo": {
    "name": "BJJ Timer",
    "slug": "app-bjj-timer",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bjjtimer",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111315",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.felipefbezerra.bjjtimer",
      "supportsTablet": true
    },
    "android": {
      "package": "com.felipefbezerra.bjjtimer",
      "adaptiveIcon": {
        "backgroundColor": "#111315",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "output": "single",
      "lang": "pt-BR",
      "themeColor": "#111315",
      "description": "Temporizador de combate, circuito e cronômetro para treinos e lutas de jiu-jitsu."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111315",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-treino-android"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
